*.py[codz]
*$py.class
*.so

# Build and packaging output (keep uv.lock tracked)
/build/
/dist/
*.egg-info/
*.egg
.eggs/

# Test, coverage, and analysis caches
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.cache/
*.log

