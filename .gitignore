# Private credentials and local configuration
.env
.env.*
!.env.example
.envrc
.pypirc

# Private task files, checkpoints, review records, and raw traces
/workspace/**
!/workspace/.gitkeep
/.state/
/traces/

# Python environments and dependency caches
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
