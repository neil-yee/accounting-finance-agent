# Copy to .env and enter your own keys. Never commit .env.
OPENAI_API_KEY=

# These defaults configure the local profile. The staged excel-benchmark-v1
# profile overrides model/reasoning/tracing/limits; inspect it with --show-config.
# It cannot run until the required benchmark safeguards are implemented.
# Defaults match the model configuration used in the learning project.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=high

# Set false to run without uploading traces to LangSmith.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=accounting-finance-agent

# --sandbox also requires LANGSMITH_API_KEY, even when tracing is false.
# Immutable snapshot ID from scripts/build_sandbox_snapshot.py; blank uses the default.
SANDBOX_SNAPSHOT_ID=
# If your LangSmith account uses another region, set its API endpoint:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Local defaults for bounded runs; these are not monetary spending caps.
AGENT_TIMEZONE=America/Toronto
AGENT_MAX_MODEL_CALLS=40
AGENT_MAX_TOOL_CALLS=120
AGENT_RUN_SECONDS=900
AGENT_MODEL_TIMEOUT_SECONDS=120
AGENT_TOOL_TIMEOUT_SECONDS=120
AGENT_MAX_OUTPUT_TOKENS=16000

# Explicit sandbox destination allowlist. Add approved source hosts as needed.
# Organization-level LangSmith egress policy may override this configuration.
SANDBOX_ALLOWED_HOSTS=pypi.org:443,files.pythonhosted.org:443,www.sec.gov:443,data.sec.gov:443
